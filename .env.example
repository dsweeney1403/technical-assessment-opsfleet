# Gemini API key from Google AI Studio (free): https://aistudio.google.com/apikey
# GOOGLE_API_KEY also works if you already have it set.
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud project used for BigQuery queries (a free BigQuery sandbox project works).
# `gcloud projects list` shows your project IDs.
# Sign in first with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
